# SQLite is the zero-configuration development default. Use a PostgreSQL URL in deployment.
DATABASE_URL=sqlite:///./data/multimodal_knowledge.db
PROCESSING_VERSION=v1
MEDIA_ROOT=./data/media
MAX_UPLOAD_BYTES=104857600
# Longest pasted-text source, in characters
MAX_TEXT_CHARACTERS=500000
# Link fetching. Private and loopback hosts are refused unless enabled.
FETCH_ALLOW_PRIVATE_HOSTS=false
FETCH_TIMEOUT_SECONDS=20
MAX_FETCH_BYTES=20971520
FETCH_MAX_REDIRECTS=5
# Preferred YouTube caption languages, comma-separated
YOUTUBE_TRANSCRIPT_LANGUAGES=en
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
FRAME_SAMPLE_FPS=1
MAX_SAMPLED_FRAMES=120
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
OCR_PROVIDER=tesseract
TESSERACT_BINARY=tesseract
AUTO_REVIEW_CONFIDENCE=0.60
CORS_ORIGINS=http://localhost:3000

# Transcription. `none` keeps the pipeline runnable without model weights.
SPEECH_PROVIDER=none
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Retrieval. `hashing` is a dependency-free lexical vectoriser; `sentence_transformer` loads EMBEDDING_MODEL.
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=256
# Load BGE-M3 and the cross-encoder reranker in fp16 (~1.1 GB each instead of ~2.2 GB).
# GPU only - ignored without CUDA, where fp16 falls back to slow emulated kernels.
RETRIEVAL_FP16=true
# Evidence handed to the vision model, in characters. Attention is quadratic in prompt
# length: an 84s screen recording produced 1,144 distinct OCR lines (~10.5k tokens) and
# asked for a 10.32 GiB attention tensor on an 8 GiB card. 0 disables the bound.
VLM_MAX_OCR_CHARS=6000
VLM_MAX_TRANSCRIPT_CHARS=4000
VECTOR_STORE=database
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=reel_content
RAG_EVIDENCE_LIMIT=8
DUPLICATE_SIMILARITY_THRESHOLD=0.92

# Perception and normalisation. `evidence`/`rule_based` are the local, no-API-key defaults.
VISION_PROVIDER=evidence
EXTRACTION_PROVIDER=rule_based
# ANTHROPIC_API_KEY is read by the SDK itself and is required for VISION_PROVIDER/EXTRACTION_PROVIDER=claude.
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MAX_TOKENS=16000
VLM_MAX_FRAMES=8

# Confidence routing: above accept, between verify, below review.
AUTO_ACCEPT_CONFIDENCE=0.85

# Answering and report narration. `extractive` quotes retrieved evidence with no API key.
ANSWER_PROVIDER=extractive
# Bumped when the extraction prompts change, so stored knowledge stays attributable.
EXTRACTION_PROMPT_VERSION=v1

# Durable media storage. `local` needs no extra service; `s3` targets S3 or MinIO.
OBJECT_STORE=local
OBJECT_STORE_ROOT=./data/objects
S3_BUCKET=
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_PREFIX=
SIGNED_URL_TTL_SECONDS=900

# Authentication. Off by default so the API is usable with a single curl command.
# Turning it on ignores X-User-Id entirely and requires a real SECRET_KEY.
AUTH_REQUIRED=false
SECRET_KEY=
TOKEN_TTL_SECONDS=43200
# 0 disables rate limiting. The limiter is per-process; use Redis for multi-instance deployments.
RATE_LIMIT_PER_MINUTE=0
LOG_LEVEL=INFO

# Reranking, the stage after fusion. `none` keeps the fused order.
RERANKER=none
RERANKER_MODEL=BAAI/bge-reranker-base
RERANK_CANDIDATES=30

# Model routing: send simple clips to a smaller vision model and escalate only on low confidence.
VISION_ROUTING=false
ANTHROPIC_SMALL_MODEL=claude-haiku-4-5
ROUTING_SIMPLE_MAX_FRAMES=4

# --- Local model configuration ---------------------------------------------
# Scene-text OCR. Much stronger than Tesseract on burned-in Reel captions.
# OCR_PROVIDER=paddleocr

# Local vision-language model. `qwen` runs on your own GPU; `claude` calls the API.
# VISION_PROVIDER=qwen
# 3B fits comfortably on an 8 GB card alongside the frame KV cache.
# Move to Qwen/Qwen2.5-VL-7B-Instruct if you have 12 GB+, or lower QWEN_MAX_PIXELS first.
QWEN_VISION_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
QWEN_LOAD_IN_4BIT=true
# Pixels per frame. Lower this first if you run out of VRAM - frames dominate the
# KV cache in a multi-image prompt. 401408 = 512*28*28.
QWEN_MAX_PIXELS=401408
QWEN_MAX_NEW_TOKENS=1024
# Force schema-valid JSON at decode time. Needs lm-format-enforcer.
QWEN_CONSTRAINED_JSON=true

# Dense retrieval and reranking (sentence-transformers).
# EMBEDDING_PROVIDER=sentence_transformer
# EMBEDDING_MODEL=BAAI/bge-m3
# RERANKER=cross_encoder
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Transcription. distil-large-v3 is ~6x faster than large-v3 with similar accuracy.
# SPEECH_PROVIDER=faster_whisper
# WHISPER_MODEL=distil-large-v3

# Extraction from the vision model's structured fields (recommended with VISION_PROVIDER=qwen
# or claude). Falls back to the regex extractor when vision returns only a description.
# EXTRACTION_PROVIDER=vision_fields

# Where the pipeline actually runs. `celery` needs Redis and a worker process; `local` runs it on a
# background thread inside the API, which is what a single-user install wants.
TASK_RUNNER=celery
